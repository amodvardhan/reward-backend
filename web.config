<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="src/index.js" verb="*" modules="iisnode" />
    </handlers>
    
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/index.js/debug[\/]?" />
        </rule>

        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="src/index.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode 
      loggingEnabled="true"
      logDirectory="iisnode_logs"
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      devErrorsEnabled="true" />

  </system.webServer>


  <appSettings>
    <add key="NODE_ENV" value="production" />
    <add key="PORT" value="3000" />
    <add key="DB_HOST" value="KSNDMCDB-SCAN.KSNDMC.COM" />
    <add key="DB_PORT" value="1521" />
    <add key="DB_SERVICE_NAME" value="ksndmc" />
    <add key="DB_USER" value="reward" />
    <add key="DB_PASSWORD" value="Reward@123" />
  </appSettings>
</configuration>
